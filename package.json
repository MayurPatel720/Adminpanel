{
  "name": "adminpanel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "env-cmd -f .env.development npm run start:flavor",
    "start:staging": "env-cmd -f .env.staging npm run start:flavor",
    "start:prod": "env-cmd -f .env.production npm run start:flavor",
    "build:dev": "env-cmd -f .env.development npm run build:flavor",
    "build:staging": "env-cmd -f .env.staging npm run build:flavor",
    "build:prod": "env-cmd -f .env.production npm run build:flavor",
    "start:dev:linux": "env-cmd -f .env.development npm run start:flavor:linux",
    "start:staging:linux": "env-cmd -f .env.staging npm run start:flavor:linux",
    "start:prod:linux": "env-cmd -f .env.production npm run start:flavor:linux",
    "build:dev:linux": "env-cmd -f .env.development npm run build:flavor:linux",
    "build:staging:linux": "env-cmd -f .env.staging npm run build:flavor:linux",
    "build:prod:linux": "env-cmd -f .env.production npm run build:flavor:linux",
    "start:flavor": "set PORT=3001 && node -r dotenv/config node_modules/react-scripts/scripts/start.js",
    "build:flavor": "set PORT=3001 && node -r dotenv/config node_modules/react-scripts/scripts/build.js",
    "start:flavor:linux": "PORT=3001 node -r dotenv/config node_modules/react-scripts/scripts/start.js",
    "build:flavor:linux": "PORT=3001 node -r dotenv/config node_modules/react-scripts/scripts/build.js",
    "start": " PORT=3001 node -r dotenv/config node_modules/react-scripts/scripts/start.js",
    "start:linux": "PORT=3001 react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "format": "prettier --write ."
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@ag-grid-community/client-side-row-model": "^31.2.1",
    "@ag-grid-community/core": "^31.2.1",
    "@ag-grid-community/csv-export": "^31.2.1",
    "@ag-grid-community/infinite-row-model": "^31.2.1",
    "@ag-grid-community/react": "^31.2.1",
    "@ag-grid-community/styles": "^31.2.1",
    "@ag-grid-enterprise/advanced-filter": "^31.2.1",
    "@ag-grid-enterprise/charts-enterprise": "^31.2.1",
    "@ag-grid-enterprise/clipboard": "^31.2.1",
    "@ag-grid-enterprise/column-tool-panel": "^31.2.1",
    "@ag-grid-enterprise/core": "^31.2.1",
    "@ag-grid-enterprise/excel-export": "^31.2.1",
    "@ag-grid-enterprise/filter-tool-panel": "^31.2.1",
    "@ag-grid-enterprise/master-detail": "^31.2.1",
    "@ag-grid-enterprise/menu": "^31.2.1",
    "@ag-grid-enterprise/multi-filter": "^31.2.1",
    "@ag-grid-enterprise/range-selection": "^31.2.1",
    "@ag-grid-enterprise/rich-select": "^31.2.1",
    "@ag-grid-enterprise/row-grouping": "^31.2.1",
    "@ag-grid-enterprise/server-side-row-model": "^31.2.1",
    "@ag-grid-enterprise/set-filter": "^31.2.1",
    "@ag-grid-enterprise/side-bar": "^31.2.1",
    "@ag-grid-enterprise/sparklines": "^31.2.1",
    "@ag-grid-enterprise/status-bar": "^31.2.1",
    "@ag-grid-enterprise/viewport-row-model": "^31.2.1",
    "@tanstack/react-form": "^0.19.0",
    "@tanstack/react-query": "^5.22.2",
    "@tanstack/yup-form-adapter": "^0.19.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.82",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "ag-grid-react": "^31.2.1",
    "axios": "^1.6.7",
    "crypto-browserify": "^3.12.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "moment": "^2.30.1",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "primeflex": "^3.3.1",
    "primeicons": "^6.0.1",
    "primereact": "^10.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "env-cmd": "^10.1.0"
  }
}
